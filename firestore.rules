rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /orders/{id} {
      // العميل يقدر ينشئ طلب ويجيب طلبه برقمه فقط، مفيش قراءة جماعية
      allow create: if request.resource.data.keys().hasAll(['customerName','customerPhone','products','total'])
                    && request.resource.data.status == 'جاري المراجعة'
                    && request.resource.data.products.size() <= 30;
      allow get: if true;
      allow list, update, delete: if request.auth != null;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
